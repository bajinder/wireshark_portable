# infra/templates/fastlane/Matchfile
#
# Points match at the local bare git repo created by
# infra/scripts/04_setup_match_repo.sh. Env-driven -- no per-app edits
# needed. `type` and `readonly` here are just the defaults for ad-hoc CLI
# use (e.g. running `fastlane match appstore` by hand); the `beta` lane in
# the Fastfile passes its own `type:`/`readonly:` explicitly, which
# overrides these.

git_url(ENV["MATCH_GIT_URL"])
storage_mode("git")
type("appstore")
readonly(false)

app_identifier(ENV["APP_IDENTIFIER"]) if ENV["APP_IDENTIFIER"]
username(ENV["APPLE_ID"]) if ENV["APPLE_ID"]
team_id(ENV["TEAM_ID"]) if ENV["TEAM_ID"]
