# infra/.env.default
#
# Master template for all environment variables used across this local iOS
# CI system (Gitea, act_runner, fastlane). Nothing in this file is a real
# secret -- every value below is either a placeholder you must fill in, or
# a safe local default.
#
# How this file is used:
#   - `infra/templates/setup.sh` copies the fastlane-relevant subset into
#     each new app repo as fastlane/.env.default (checked into git, no
#     secrets) and creates a separate fastlane/.env (gitignored, real
#     values) alongside it.
#   - fastlane auto-loads `fastlane/.env.default` then `fastlane/.env` on
#     every run (the latter overrides the former), so app-specific values
#     land in .env and shared secrets can live in the runner's own shell
#     environment (see infra/launchd/com.local.act-runner.plist) instead of
#     being duplicated into every app repo.
#   - `infra/scripts/05_verify_e2e.sh` and `infra/templates/setup.sh` also
#     read GITEA_* below directly from your shell environment.
#
# NEVER commit a filled-in copy of this file (the real .env files) to git.
# Only *.env.default (placeholders only) belongs in version control.

# ----------------------------------------------------------------------------
# Gitea (local git server / CI control plane)
# ----------------------------------------------------------------------------

# Base URL of the local Gitea instance. Must match GITEA__server__ROOT_URL
# in infra/docker-compose.yml.
GITEA_INSTANCE_URL=http://localhost:3000

# Admin username created by infra/scripts/01_start_gitea.sh.
GITEA_ADMIN_USER=admin

# Personal access token used by infra/templates/setup.sh and
# infra/scripts/05_verify_e2e.sh to call the Gitea API (create repos, poll
# Actions status, delete throwaway repos).
#
# Create it yourself: Gitea web UI -> click your avatar (top right) ->
# Settings -> Applications -> "Manage Access Tokens" -> Generate New Token.
# Give it a name (e.g. "infra-cli") and at minimum these scopes: `repo`
# (read/write/delete repositories) and `admin:org` if you plan to create
# repos under an organization instead of your user account.
# There is no way to generate this non-interactively before the instance
# exists, so this MUST be filled in by hand -- it is intentionally left
# blank here.
GITEA_TOKEN=

# ----------------------------------------------------------------------------
# App Store Connect API key (used by fastlane match + pilot + deliver)
# ----------------------------------------------------------------------------
# These three values come from App Store Connect. You must create them
# yourself; do not invent placeholder-looking values here and use them for
# real -- fastlane will fail (correctly) until these point at a real key.
#
# Exact click path to create the key:
#   1. https://appstoreconnect.apple.com -> Users and Access
#   2. Integrations tab -> App Store Connect API
#   3. "Team Keys" section -> click "Generate API Key" (+)
#   4. Name it (e.g. "local-ci"), Access = "App Manager"
#   5. Download the .p8 FILE IMMEDIATELY -- Apple only lets you download it
#      once, ever. If you lose it you must revoke and generate a new key.
#   6. Note the Key ID (shown in the table) and the Issuer ID (shown above
#      the table, same for all keys on the team).
#
# Move the downloaded .p8 to: ~/infra/keys/AuthKey_<KEY_ID>.p8
# (infra/scripts/02_install_runner.sh creates the ~/infra/keys directory.)

# Key ID column value from the Team Keys table, e.g. "ABCD123XYZ".
ASC_KEY_ID=

# Issuer ID shown above the Team Keys table (same for every key on the
# team), a UUID, e.g. "69a6de70-03db-47e3-e053-5b8c7c11a4d1".
ASC_ISSUER_ID=

# Absolute path to the downloaded .p8, following the convention above.
ASC_KEY_PATH=$HOME/infra/keys/AuthKey_${ASC_KEY_ID}.p8

# ----------------------------------------------------------------------------
# fastlane match (code signing certificate/profile storage)
# ----------------------------------------------------------------------------

# Passphrase match uses to encrypt everything it stores in the certs git
# repo. Pick your own strong passphrase the first time you run
# `fastlane match`; match will re-derive/verify it on every subsequent run
# and will REFUSE to decrypt if this doesn't match what was used to
# initialize the repo. There is no way to recover this if lost -- you would
# have to wipe ~/infra/certs.git and re-run match, regenerating certs.
MATCH_PASSWORD=

# Local bare git repo created by infra/scripts/04_setup_match_repo.sh.
# file:// URL to a local path works fine as a match storage backend.
MATCH_GIT_URL=file://$HOME/infra/certs.git

# ----------------------------------------------------------------------------
# Physical test device (used by the "test" lane's `run_tests` destination)
# ----------------------------------------------------------------------------

# UDID of the plugged-in iPhone used for on-device XCUITest runs. Find it
# with: `xcrun xctrace list devices` (look for your iPhone's line) or
# Xcode -> Window -> Devices and Simulators. If this device isn't attached
# when a test run starts, the Fastfile "test" lane falls back to a
# simulator and prints a loud warning instead of failing.
DEVICE_ID=

# ----------------------------------------------------------------------------
# Per-app values (set these per repo in fastlane/.env, NOT here)
# ----------------------------------------------------------------------------
# Left here only as documentation of the expected variable names -- do not
# fill these in in the shared/master template. infra/templates/setup.sh
# writes real per-app values into each app repo's own fastlane/.env.

# Bundle identifier of the app, e.g. "com.example.myapp".
APP_IDENTIFIER=

# Xcode scheme to build/test, e.g. "MyApp".
SCHEME=
