# apps/Deepwork/fastlane/.env.default
#
# Committed placeholders/known values for Deepwork specifically (see
# infra/.env.default for the full master list and infra/templates/setup.sh
# for how this file is normally generated). Real secrets (ASC_*,
# MATCH_PASSWORD, MATCH_GIT_URL, DEVICE_ID) belong in fastlane/.env
# (gitignored) and/or the CI runner's own host environment -- do NOT put
# secrets in this file.
APP_IDENTIFIER=com.bajinder.deepwork
SCHEME=Deepwork
DEVICE_ID=
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=
MATCH_PASSWORD=
MATCH_GIT_URL=
