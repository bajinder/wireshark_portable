# Defaults for Keeply — loaded automatically by fastlane, and overridden by
# fastlane/.env (gitignored), which infra/templates/setup.sh writes with your
# real values (device UDID, and optionally ASC_*/MATCH_* if kept per-repo).
APP_IDENTIFIER=com.bajinder.keeply
SCHEME=Keeply
# Physical iPhone UDID (from: xcrun devicectl list devices). Left empty, the
# test lane falls back to a simulator with a loud warning.
DEVICE_ID=
